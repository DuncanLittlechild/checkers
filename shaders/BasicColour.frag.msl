#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_OncePerObject
{
    float3 trueColour;
};

struct main0_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

fragment main0_out main0(constant type_OncePerObject& OncePerObject [[buffer(1)]])
{
    main0_out out = {};
    out.out_var_SV_Target0 = float4(OncePerObject.trueColour, 1.0);
    return out;
}

